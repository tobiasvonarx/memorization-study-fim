# Shared rebuild configuration for memorization-study-fim.
# Source from Slurm launchers or shells with:
#   set -a; source config.env; set +a

REBUILD_USER="${USER:-tvonarx}"

SCRATCH_ROOT="/iopsstor/scratch/cscs/${REBUILD_USER}"
PERSISTENT_ROOT="/capstor/store/cscs/swissai/infra01/users/${REBUILD_USER}"
CAPSTOR_ROOT="${PERSISTENT_ROOT}"
REPO_ROOT="${REPO_ROOT:-${SCRATCH_ROOT}/memorization-study-fim}"

# Local software roots
CONDA_ROOT="${CONDA_ROOT:-/users/${REBUILD_USER}/miniconda3}"
CONDA_PROFILE="${CONDA_PROFILE:-${CONDA_ROOT}/etc/profile.d/conda.sh}"
PYTHON_BIN="${PYTHON_BIN:-${CONDA_ROOT}/bin/python}"

# External checkouts
MEGATRON_DIR="${SCRATCH_ROOT}/megatron-lm"
DATATROVE_SRC_DIR="${SCRATCH_ROOT}/datatrove"

# Artifact roots
DATASET_ROOT="${PERSISTENT_ROOT}/datasets"
RUNS_ROOT="${PERSISTENT_ROOT}/runs"
TOKENIZER_ROOT="${SCRATCH_ROOT}/tokenizer"
LOG_ROOT="${SCRATCH_ROOT}/data/log"
RESULTS_ROOT="${REPO_ROOT}/results"

# Containers. Override these in the submission environment if using a different image.
IMAGE_PATH="${PERSISTENT_ROOT}/images/qwen_fim_rebuild_v1.sqsh"
PRETRAIN_IMAGE_PATH="${PERSISTENT_ROOT}/images/qwen.sqsh"
CONTAINER_MOUNTS="/iopsstor/scratch:/iopsstor/scratch,/capstor/store:/capstor/store,/capstor/scratch:/capstor/scratch"

# Tokenizer
TOKENIZER_ID="meta-llama/Llama-3.2-3B"
HF_TOKENIZER_DIR="${TOKENIZER_ROOT}/llama3_2_3B_tokenizer"
LLAMA_TOKENIZER_PATH="${HF_TOKENIZER_DIR}"

# Dataset paths
COMBINED_NO_FIM_DATASET="${DATASET_ROOT}/combined_no_fim"
COMBINED_FIM_V2_DATASET="${DATASET_ROOT}/combined_fim_v2"
FINEWEB_DOWNLOAD_DIR="${PERSISTENT_ROOT}/fineweb_sample_100BT"
FINEWEB_TEXT_JSONL_DIR="${DATASET_ROOT}/fineweb/fineweb_100BT_text_jsonl"
FINEWEB_LLAMA_RAW_DIR="${DATASET_ROOT}/fineweb/fineweb_100BT_llama_raw"
FINEWEB_NO_FIM_DIR="${DATASET_ROOT}/fineweb/fineweb_100BT_llama_no_fim"
FINEWEB_FIM_DIR="${DATASET_ROOT}/fineweb/fineweb_100BT_llama_fim"

GUTENBERG_FILTERED_DIR="${DATASET_ROOT}/gutenberg/4096_tokens_filtered"
GUTENBERG_REPLICAS_DIR="${DATASET_ROOT}/gutenberg/4096_tokens_filtered_with_replicas"
GUTENBERG_REPLICAS_V2_DIR="${DATASET_ROOT}/gutenberg/4096_tokens_filtered_with_replicas_v2"
GUTENBERG_LTR_DIR="${DATASET_ROOT}/gutenberg/4096_tokens_no_fim"
GUTENBERG_FIM_DIR="${DATASET_ROOT}/gutenberg/4096_tokens_with_fim"
GUTENBERG_FIM_V2_DIR="${DATASET_ROOT}/gutenberg/4096_tokens_with_fim_v2"

# Megatron --load expects the checkpoint root containing latest_checkpointed_iteration.txt.
FINEWEB_PRELIM_CHECKPOINT="${RUNS_ROOT}/llama3_2_3B_pretrain_fineweb_only/checkpoint/llama3_2_3B-lr-3e-4-minlr-3e-5-gbs-2048-seqlen-16384-tp-1-pp-1"

# Evaluation
LMEVAL_DIR="${SCRATCH_ROOT}/lm-evaluation-harness"
